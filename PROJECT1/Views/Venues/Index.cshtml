@model IEnumerable<PROJECT1.Models.Venue>

@{
    ViewData["Title"] = "Venue Index";
}

<h1>Venues</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Venue</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Venue Name</th>
            <th>Location</th>
            <th>Capacity</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.VenueName</td>
                <td>@item.VenueLocation</td>
                <td>@item.VenueCapacity</td>
                <td>
                    <img src="@item.imageUrl" alt="Venue Image" style="height: 80px;" />
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.VenueId" class="btn btn-warning">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.VenueId" class="btn btn-info">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.VenueId" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
